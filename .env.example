# Environment configuration — docs/spec.md Appendix A.
# Copy to .env and fill in. No real values belong in this file.
#
# Anything marked <secret> must come from a secret manager in staging and
# production. SECRET_KEY_ID is a reference, never a literal key.

# --- core
APP_ENV=development
SECRET_KEY_ID=
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_rs256.pem
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Host-facing values, for running alembic, pytest, and tooling outside Docker.
# docker-compose.yml overrides all three for the api and worker containers,
# which reach the services by their in-network names instead.
# Postgres is published on 5433 because a local install commonly owns 5432.
DATABASE_URL=postgresql+psycopg://marking_app:marking_app@localhost:5433/marking
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=marking-assistant
S3_REGION=us-east-1

# --- pipeline versions (pinned; changing any invalidates caches)
PIPELINE_VERSION=2.3.1
RULE_ENGINE_VERSION=4.2.0
EMBEDDING_MODEL=bge-m3@1.0
RERANKER_MODEL=bge-reranker-v2-m3@1.0
NLI_MODEL=deberta-v3-base-mnli@1.0
PROMPT_VERSION=v3

# --- providers
OCR_PRIMARY=google_vision
OCR_SECONDARY=azure_read
OCR_ARBITER=gemini_flash_lite
ENTAILMENT_PROVIDER=gemini_flash_lite
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=3
CIRCUIT_BREAKER_THRESHOLD=5

# --- thresholds (defaults; per-tenant overrides bounded by these)
IMAGE_QUALITY_REJECT=0.50
IMAGE_QUALITY_WARN=0.70
OCR_TIER2_THRESHOLD=0.88
OCR_TIER2_MAX_LINES_PER_PAGE=30
ENTAIL_CONFIDENCE_FLOOR=0.65
AUTO_SUGGEST_THRESHOLD=0.85
MANUAL_ONLY_THRESHOLD=0.70
PLATFORM_MIN_AUTO_SUGGEST=0.80

# --- limits
MAX_UPLOAD_BYTES=15728640
MAX_BATCH_FILES=500
MAX_IMAGE_PIXELS=80000000
WORK_LONG_EDGE=2400
TENANT_MONTHLY_AI_CAP_USD=100
TENANT_MAX_INFLIGHT_JOBS=50

# --- retention
IMAGE_RETENTION_DAYS=180
MARKS_RETENTION_DAYS=2555

# --- provider credentials (leave blank until you have them)
#
# NEVER put real values in this file - it is committed. Put them in .env,
# which is gitignored. A key in git history is a key that must be rotated.
#
# Path to the service-account JSON from Google Cloud. The path, not the
# contents: keep the file itself outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fernet keys for encrypting student index numbers, newest first, comma
# separated. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IDENTITY_ENCRYPTION_KEYS=
